rules_version = '2';

// 브라우저(교사·학생)는 Firestore에 직접 접근하지 않습니다.
// 문제 등록·공개 변경·결과 조회·결과 저장은 모두 앱 서버(app/api/**)가 권한을 확인한 뒤
// 서버 전용 계정으로 처리합니다. 서버 계정은 이 규칙의 영향을 받지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
